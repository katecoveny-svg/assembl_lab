{
 "contract": "assembl.particles.v1",
 "asset": "particles-apparatus.glb",
 "units": "metres",
 "route": "/study/m/particles.html",
 "coordinates": {
  "authoring": "Blender +X right, +Y rear, +Z up",
  "gltf": "glTF +X right, +Y up, +Z front",
  "map": "(x,y,z) -> (x,z,-y)",
  "legacy_scene_units_per_metre": 25,
  "legacy_note": "The lesson's 3D bench draws particles in scene units. Apply ONE uniform root scale of 25; never scale rig parts individually."
 },
 "state_owner": "study/m/particles.js owns the heating model (stateFrom, boilPoint, pressureAt), the gas law pressure(), the timer, controls, lesson A/B capture and every challenge. This asset holds no physics, timer or random values.",
 "rig": {
  "plunger": {
   "node": "PLUNGER_SLIDE",
   "axis_gltf": "parent +X",
   "input": "existing s.vol (mL)",
   "rest_volume_mL": 60,
   "metres_per_mL": 0.0011014182912933931,
   "geometry_range_mL": [
    0,
    100
   ],
   "lesson_range_mL": [
    20,
    100
   ],
   "pose": "position.x = rest.x + (volume_mL - 60) * metres_per_mL"
  },
  "gauge_needle": {
   "node": "GAUGE_NEEDLE_PIVOT",
   "axis_gltf": "local +Z (dial normal, towards the viewer)",
   "input": "existing pressure() in kPa",
   "zero_angle_deg": 225,
   "sweep_deg": 270,
   "full_scale_kPa": 400,
   "direction": "clockwise as seen from the front",
   "pose": "rotation.z = -clamp(kPa, 0, 400) / 400 * 1.5 * PI",
   "note": "Display clamp only; readouts keep the model's value."
  },
  "thermometer": {
   "node": "THERMO_SPIRIT_PIVOT",
   "axis_gltf": "local +Y",
   "input": "existing stateFrom(...).T in degrees C",
   "scale_min_C": -30.0,
   "scale_max_C": 140.0,
   "pose": "scale.y = clamp((T + 30) / 170, 0.01, 1)",
   "world_y_at_min_m": 0.1245,
   "world_y_at_max_m": 0.3245,
   "world_xz_m": [
    0.033,
    -0.037
   ]
  },
  "water": {
   "node": "WATER_PIVOT",
   "mesh": "WATER_VOLUME",
   "axis_gltf": "local +Y",
   "rest_height_m": 0.04,
   "input": "liquid height in metres from the lesson's existing liqTop mapping (particle sample, not 500 mL)",
   "pose": "scale.y = clamp(height_m / 0.040, 0.02, 2.5); visible flag from the lesson"
  },
  "heat_coil": {
   "node": "HEAT_COIL",
   "input": "heat level 0..1 already smoothed by the lesson",
   "pose": "material colour lerp #D9CCD3 -> #E58A9E; no emission or bloom"
  },
  "status_led": {
   "node": "STATUS_LED",
   "pose": "colour #BFE8D6 when idle, #E8688A while the lesson is heating; no emission"
  },
  "power_knob": {
   "node": "POWER_KNOB_PIVOT",
   "axis_gltf": "local +Z",
   "input": "existing s.power (kW)",
   "range_kW": [
    0.5,
    3.0
   ],
   "pose": "rotation.z = -(clamp(kW, 0.5, 3) - 0.5) / 2.5 * 1.5 * PI"
  }
 },
