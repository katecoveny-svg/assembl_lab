{
  "contract": "assembl.lines.v1",
  "asset": "lines-tanks.glb",
  "units": "metres",
  "route": "/study/m/lines.html",
  "coordinates": {
    "authoring": "Blender +X right, +Y rear, +Z up; tank fronts face -Y",
    "gltf": "glTF +X right, +Y up, +Z front",
    "map": "(x,y,z) -> (x,z,-y)",
    "scene_units_per_metre": 3,
    "scene_note": "The existing lines3d tank drew 100 L as TH = 3.0 scene units. The browser applies ONE uniform scale of 3 to each tank root; never scale parts individually.",
    "authored_layout_x_m": {
      "A": -0.31,
      "B": 0.31
    },
    "layout_note": "Each TANK_<k> root may be translated as a whole (the lesson slides tank A aside when B appears). Nothing inside a tank moves except the controls below."
  },
  "state_owner": "study/m/lines.js owns s (mA, cA, mB, cB, t, B, playing) and lev(m, c, t) = m*t + c. The adapter receives litres already computed by lev(); it never integrates flow, advances time, clamps the lesson model or decides whether a tap runs.",
  "level_mapping": {
    "interior_plan_m": [
      0.4,
      0.25
    ],
    "plan_area_m2": 0.1,
    "metres_per_litre": 0.01,
    "formula": "level_m = clamp(litres, 0, 100) * 0.01   (1 L = 0.001 m^3 over 0.1 m^2 = 10 mm)",
    "display_clamp_note": "The 0..100 L clamp is the same display clamp the existing drawing uses (clamp(lev, 0, 100)); readouts still show the unclamped model value.",
    "floor_y_gltf_m": 0.187,
    "full_litres": 100.0,
    "full_height_m": 1.0,
    "tested_cases": [
      {
        "litres": 40,
        "level_m": 0.4,
        "water_top_y_gltf_m": 0.587,
        "water_node_scale_y": 0.4,
        "scene_units_above_floor": 1.2
      },
      {
        "litres": 70,
        "level_m": 0.7,
        "water_top_y_gltf_m": 0.887,
        "water_node_scale_y": 0.7,
        "scene_units_above_floor": 2.1
      }
    ]
  },
  "controls": {
    "water": {
      "node": "TANK_<k>_WATER",
      "pivot": "interior floor",
      "property": "scale.y (glTF local +Y)",
      "value": "level_m / 1.00  (= litres / 100), absolute",
      "visible": "litres > 0.2 (as the existing drawing)"
    },
    "float": {
      "node": "TANK_<k>_FLOAT",
      "property": "position.y",
      "value": "floor_y + max(level_m, 0.023)",
      "note": "Below 2.3 L the float rests on its stop collar. Visual only; the float is also the drag handle for the start level."
    },
    "inlet_stream": {
      "node": "TANK_<k>_INLET_STREAM",
      "pivot": "nozzle tip",
      "property": "scale.y",
      "rest_length_m": 1.113,
      "value": "(nozzle_y - (floor_y + level_m)) / (nozzle_y - floor_y)",
      "radius_scale": "0.6 + 0.9 * min(1, rate / 8)  (x and z)",
      "visible": "caller passes filling = rate > 0 && t < 20 && litres < 100 (the existing condition)"
    },
    "drain_stream": {
      "node": "TANK_<k>_DRAIN_STREAM",
      "pivot": "drain spout tip",
      "property": "visible + radius scale",
      "visible": "caller passes draining = rate < 0 && litres > 0 (the existing condition)",
      "radius_scale": "0.6 + 0.9 * min(1, -rate / 8)"
    },
    "inlet_handwheel": {
      "node": "TANK_<k>_INLET_HANDWHEEL",
      "axis_gltf": "local +Y",
      "value": "rotation.y = -min(1, max(0, rate) / 8) * 1.5 * PI",
      "note": "Illustrative valve opening from the lesson rate. Valve hydraulics are not modelled."
    },
    "outlet_lever": {
      "node": "TANK_<k>_OUTLET_LEVER",
      "axis_gltf": "local +Y",
      "value": "rotation.y = -min(1, max(0, -rate) / 8) * PI / 2",
      "note": "Quarter-turn ball valve: closed across the pipe, open along it. Illustrative only."
    }
  },
  "tanks": {
    "A": {
      "root": "TANK_A",
      "water": "TANK_A_WATER",
      "float": "TANK_A_FLOAT",
      "inlet_stream": "TANK_A_INLET_STREAM",
