{
 "cleanUrls": false,
 "trailingSlash": true,
 "regions": [
  "syd1"
 ],
 "functions": {
  "api/read.js": {
   "maxDuration": 30,
   "includeFiles": "contracts/**"
  },
  "api/live.js": {
   "maxDuration": 15,
   "includeFiles": "api/_feeds/snapshots/**"
  },
  "api/ask.js": {
   "maxDuration": 20
  },
  "api/mcp.js": {
   "maxDuration": 20,
   "includeFiles": "api/_feeds/snapshots/**"
  }
 },
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    },
    {
     "key": "Permissions-Policy",
     "value": "camera=(self), microphone=(), geolocation=()"
    }
   ]
  }
 ]
}