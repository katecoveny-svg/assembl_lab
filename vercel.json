{
 "cleanUrls": false,
 "trailingSlash": true,
 "regions": [
  "syd1"
 ],
 "functions": {
  "api/read.js": {
   "maxDuration": 30,
   "includeFiles": "contracts/**"
  },
  "api/live.js": {
   "maxDuration": 15,
   "includeFiles": "api/_feeds/snapshots/**"
  },
  "api/ask.js": {
   "maxDuration": 20
  },
  "api/tutor.js": {
   "maxDuration": 45
  },
  "api/mcp.js": {
   "maxDuration": 30,
   "includeFiles": "api/_feeds/snapshots/**"
  },
  "api/plan-read.js": {
   "maxDuration": 60
  },
  "api/plan-render.js": {
   "maxDuration": 20
  }
 },
 "redirects": [
  {
   "source": "/next/:path*",
   "destination": "/",
   "permanent": false
  },
  {
   "source": "/cars/dealer-twin/private/:path*",
   "destination": "/cars/dealer-twin/",
   "permanent": false
  },
  {
   "source": "/whaiao-story/:path*",
   "destination": "/",
   "permanent": false
  },
  {
   "source": "/",
   "has": [
    {
     "type": "host",
     "value": "auto.assembl.co.nz"
    }
   ],
   "destination": "/cars/",
   "permanent": false
  },
  {
   "source": "/",
   "has": [
    {
     "type": "host",
     "value": "study.assembl.co.nz"
    }
   ],
   "destination": "/study/",
   "permanent": false
  },
  {
   "source": "/m/:path(.*)",
   "has": [
    {
     "type": "host",
     "value": "study.assembl.co.nz"
    }
   ],
   "destination": "/study/m/:path",
   "permanent": false
  },
  {
   "source": "/year9/:path(.*)",
   "has": [
    {
     "type": "host",
     "value": "study.assembl.co.nz"
    }
   ],
   "destination": "/study/year9/:path",
   "permanent": false
  },
  {
   "source": "/lessons/:path(.*)",
   "has": [
    {
     "type": "host",
     "value": "study.assembl.co.nz"
    }
   ],
   "destination": "/study/lessons/:path",
   "permanent": false
  },
  {
   "source": "/patterns/:path(.*)",
   "has": [
    {
     "type": "host",
     "value": "study.assembl.co.nz"
    }
   ],
   "destination": "/study/patterns/:path",
   "permanent": false
  },
  {
   "source": "/teacher.html",
   "has": [
    {
     "type": "host",
     "value": "study.assembl.co.nz"
    }
   ],
   "destination": "/study/teacher.html",
   "permanent": false
  }
 ],
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    },
    {
     "key": "Permissions-Policy",
     "value": "camera=(self), microphone=(), geolocation=()"
    }
   ]
  },
  {
   "source": "/study/lessons/climate/embed/:path*",
   "headers": [
    {
     "key": "Permissions-Policy",
     "value": "camera=(), microphone=(), geolocation=(), payment=()"
    },
    {
     "key": "Referrer-Policy",
     "value": "no-referrer"
    }
   ]
  },
  {
   "source": "/ar/worlds/files/(.*)\\.usdz",
   "headers": [
    {
     "key": "Content-Type",
     "value": "model/vnd.usdz+zip"
    },
    {
     "key": "Cache-Control",
     "value": "public, max-age=3600"
    },
    {
     "key": "Access-Control-Allow-Origin",
     "value": "*"
    }
   ]
  },
  {
   "source": "/ar/worlds/files/(.*)\\.glb",
   "headers": [
    {
     "key": "Content-Type",
     "value": "model/gltf-binary"
    },
    {
     "key": "Cache-Control",
     "value": "public, max-age=3600"
    },
    {
     "key": "Access-Control-Allow-Origin",
     "value": "*"
    }
   ]
  },
  {
   "source": "/auckland/3d/auckland-tabletop.glb",
   "headers": [
    {
     "key": "Content-Type",
     "value": "model/gltf-binary"
    },
    {
     "key": "Access-Control-Allow-Origin",
     "value": "*"
    },
    {
     "key": "Cache-Control",
     "value": "public, max-age=3600"
    }
   ]
  },
  {
   "source": "/auckland/3d/auckland-tabletop.usdz",
   "headers": [
    {
     "key": "Content-Type",
     "value": "model/vnd.usdz+zip"
    },
    {
     "key": "Access-Control-Allow-Origin",
     "value": "*"
    },
    {
     "key": "Cache-Control",
     "value": "public, max-age=3600"
    }
   ]
  }
 ],
 "rewrites": [
  {
   "source": "/ar/w/:id/",
   "destination": "/ar/w/index.html"
  },
  {
   "source": "/ar/w/:id",
   "destination": "/ar/w/index.html"
  }
 ]
}
