{
 "cleanUrls": false,
 "trailingSlash": true,
 "regions": [
  "syd1"
 ],
 "functions": {
  "api/read.js": {
   "maxDuration": 30,
   "includeFiles": "contracts/**"
  },
  "api/live.js": {
   "maxDuration": 15,
   "includeFiles": "api/_feeds/snapshots/**"
  },
  "api/ask.js": {
   "maxDuration": 20
  },
  "api/tutor.js": {
   "maxDuration": 45
  },
  "api/mcp.js": {
   "maxDuration": 30,
   "includeFiles": "api/_feeds/snapshots/**"
  },
  "api/plan-read.js": {
   "maxDuration": 60
  },
  "api/plan-render.js": {
   "maxDuration": 20
  }
 },
 "redirects": [
  {
   "source": "/next/:path*",
   "destination": "/",
   "permanent": false
  },
  {
   "source": "/",
   "has": [
    {
     "type": "host",
     "value": "auto.assembl.co.nz"
    }
   ],
   "destination": "/cars/",
   "permanent": false
  },
  {
   "source": "/",
   "has": [
    {
     "type": "host",
     "value": "study.assembl.co.nz"
    }
   ],
   "destination": "/study/",
   "permanent": false
  },
  {
   "source": "/m/:path(.*)",
   "has": [
    {
     "type": "host",
     "value": "study.assembl.co.nz"
    }
   ],
   "destination": "/study/m/:path",
   "permanent": false
  },
  {
   "source": "/year9/:path(.*)",
   "has": [
    {
     "type": "host",
     "value": "study.assembl.co.nz"
    }
   ],
   "destination": "/study/year9/:path",
   "permanent": false
  },
  {
   "source": "/lessons/:path(.*)",
   "has": [
    {
     "type": "host",
     "value": "study.assembl.co.nz"
    }
   ],
   "destination": "/study/lessons/:path",
   "permanent": false
  },
  {
   "source": "/patterns/:path(.*)",
   "has": [
    {
     "type": "host",
     "value": "study.assembl.co.nz"
    }
   ],
   "destination": "/study/patterns/:path",
   "permanent": false
  },
  {
   "source": "/teacher.html",
   "has": [
    {
     "type": "host",
     "value": "study.assembl.co.nz"
    }
   ],
   "destination": "/study/teacher.html",
   "permanent": false
  }
 ],
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    },
    {
     "key": "Permissions-Policy",
     "value": "camera=(self), microphone=(), geolocation=()"
    }
   ]
  },
  {
   "source": "/study/lessons/climate/embed/:path*",
   "headers": [
    {
     "key": "Permissions-Policy",
     "value": "camera=(), microphone=(), geolocation=(), payment=()"
    },
    {
     "key": "Referrer-Policy",
     "value": "no-referrer"
    }
   ]
  }
 ]
}
